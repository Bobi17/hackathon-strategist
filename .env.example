# ── LLM provider (set exactly one — auto-detected) ──────────────────────────
#
# Provider-agnostic OpenAI-compatible gateway (OmniRoute, LiteLLM, Ollama, vLLM,
# LM Studio, LocalAI, etc.). All three required; a missing value fails fast.
LLM_API_KEY=your-api-key
LLM_BASE_URL=http://localhost:4000/v1
LLM_MODEL=anthropic/claude-sonnet-4-5-20250514

# Option: Anthropic direct API (mutually exclusive with the three above)
# Use this when you want to hit the official Anthropic API or an Anthropic-compatible
# gateway. LLM_BASE_URL is optional — omit to use the official API.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250514
# ANTHROPIC_BASE_URL=

# ── LLM client tuning ───────────────────────────────────────────────────────
# Per-call timeout for OpenAI-compatible gateways (ms). Concurrent persona
# calls can exceed 60s; timeouts are retried once. Default 120000.
# LLM_TIMEOUT_MS=120000

# ── Control room (optional) ──────────────────────────────────────────────────
# Port for the live control-room UI (http + websocket).
CONTROL_ROOM_PORT=8787

# ── Output ──────────────────────────────────────────────────────────────────
# Where the markdown artifacts land (spec.md, implementation-plan.md, ...).
# Defaults to `output/` — gitignored.
OUTPUT_DIR=output