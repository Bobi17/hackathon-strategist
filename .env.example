# ── LLM provider (set exactly one — auto-detected in priority order) ───────
#
# The provider URL, API key, and model are read ONLY from this file (copied to
# .env.local) or from already-exported shell env. Nothing is hardcoded in the
# codebase — a missing value fails fast with a clear error, never a silent
# fallback. Priority: OMNIROUTE > LITELLM > ANTHROPIC.
#
# Option 1: OmniRoute (OpenAI-compatible gateway)
#   OMNIROUTE_API_KEY=your-omniroute-key
#   OMNIROUTE_BASE_URL=http://localhost:2016/v1
#   OMNIROUTE_MODEL=auto
#
# Option 2: LiteLLM (OpenAI-compatible gateway)
#   LITELLM_API_KEY=your-litellm-key
#   LITELLM_BASE_URL=http://localhost:4000/v1
#   LITELLM_MODEL=anthropic/claude-sonnet-4-5-20250514
#
# Option 3: Anthropic (direct API). ANTHROPIC_BASE_URL is optional — omit it to
# use the official Anthropic API.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-5-20250514
# ANTHROPIC_BASE_URL=http://localhost:2016/v1

# ── LLM client tuning ─────────────────────────────────────
# Per-call timeout for OpenAI-compatible gateways (ms). Concurrent persona
# calls can exceed 60s; timeouts are retried once. Default 120000.
# LLM_TIMEOUT_MS=120000

# ── Control room (optional) ────────────────────────────────
# Port for the live control-room UI (http + websocket).
CONTROL_ROOM_PORT=8787

# ── Output ─────────────────────────────────────────────────
# Where the markdown artifacts land (spec.md, implementation-plan.md, ...).
# Defaults to `output/` — gitignored.
OUTPUT_DIR=output
